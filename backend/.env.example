# Google AI Studio -> https://ai.google.dev/  (see root README for exact steps)
GEMINI_API_KEY=

# Monlam TTS — https://api-v1.monlamai.studio/docs
# Auth header is X-API-Key. Voices: lhasa_female, lhasa_male, amdo_female,
# amdo_male, kham_female, kham_male.
MONLAM_API_KEY=
MONLAM_API_URL=https://api-v1.monlamai.studio/api/v1/text-to-speech/stream
MONLAM_VOICE_NAME=lhasa_female

# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
