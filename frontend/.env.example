# Leave all of these unset to run the app in fully offline demo mode
# (mock recognition, local-only progress, browser speech fallback for audio).

# FastAPI backend base URL (see backend/.env.example for the keys it needs)
VITE_API_URL=http://localhost:8000

# Firebase client config — from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
